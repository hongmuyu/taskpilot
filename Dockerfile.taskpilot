FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

WORKDIR /srv/taskpilot

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/var/cache/taskpilot/huggingface

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir uv==0.10.9

COPY requirements-service.lock.txt ./
RUN uv pip install --system --no-cache --torch-backend cpu -r requirements-service.lock.txt

COPY app ./app
COPY config/config.example-baseline.toml ./config/config.example.toml

RUN mkdir -p logs /var/cache/taskpilot/huggingface

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=300s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).read()"

CMD ["python", "-m", "app.taskpilot.container_start"]
