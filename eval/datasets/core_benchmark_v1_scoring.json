{
  "rubric": "taskpilot_core_final",
  "version": "1.0.0",
  "frozen_before_runs": true,
  "benchmark_runs_recorded": 0,
  "normalization": {
    "tool_name": "exact_public_name",
    "repository": "case_insensitive_owner_and_repo",
    "ref": "exact_commit_sha",
    "issue_number": "exact_integer_boolean_rejected",
    "path": "exact_repository_relative_path",
    "query": "casefold_and_trim; all_gold_identifier_terms_present_in_any_order; informative_extra_terms_allowed",
    "mcp_text": "exact_string"
  },
  "metrics": {
    "candidate_recall": {
      "unit": "selection_eligible_tool_step",
      "numerator": "steps_where_candidate_set_intersects_acceptable_tools",
      "denominator": "supported_attempted_selection_eligible_tool_steps",
      "missing_candidate_set": "incorrect_if_routing_enabled_else_not_applicable",
      "excluded_actions": [
        "clarify",
        "reject",
        "no_match"
      ]
    },
    "tool_selection_accuracy": {
      "unit": "selection_eligible_tool_step",
      "eligible_actions": [
        "tool"
      ],
      "numerator": "steps_where_final_selected_public_tool_name_is_in_acceptable_tools",
      "denominator": "supported_attempted_selection_eligible_tool_steps",
      "wrong_missing_or_failed_selection": "incorrect",
      "excluded_actions": [
        "clarify",
        "reject",
        "no_match"
      ]
    },
    "task_success_rate": {
      "unit": "task",
      "numerator": "supported_attempted_tasks_with_all_business_evidence_verified_and_no_failure_condition",
      "denominator": "all_predeclared_supported_attempted_tasks_including_failed_and_not_verified",
      "finish_declaration_is_success": false,
      "evidence_source": "actual_tool_http_mcp_trace_and_cited_result_not_agent_finish_declaration"
    },
    "slot_precision_recall_f1": {
      "unit": "critical_slot_name_normalized_value_pair_on_supported_attempted_steps",
      "true_positive": "emitted_pair_matches_gold_pair",
      "false_positive": "emitted_pair_not_in_gold_pairs_including_guess_or_wrong_value",
      "false_negative": "gold_pair_not_emitted",
      "precision": "TP/(TP+FP)",
      "recall": "TP/(TP+FN)",
      "f1": "2*precision*recall/(precision+recall)",
      "undefined_denominator": "NOT_APPLICABLE_with_raw_counts_reported",
      "unresolved_missing_slot": "exclude_value_pair_until_user_reply; score_clarification_and_zero_dispatch_separately",
      "provenance": "audit_separately_against_slot_source;_not_inferred_from_value",
      "invalid_slot": "exclude_invalid_gold_value_pair; score rejection_and_zero_dispatch_separately"
    },
    "provider_token_usage": {
      "unit": "task_and_llm_call",
      "fields": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "source": "provider_reported_usage_only",
      "missing_usage": "unknown_not_zero",
      "estimates": "separate_non_primary_field_never_measured_usage",
      "aggregation": "sum_each_distinct_llm_call_once_including_failed_retry_calls_when_reported"
    },
    "end_to_end_latency": {
      "unit": "task",
      "start": "request_accepted_monotonic_clock",
      "end": "terminal_status_and_cleanup_completed_monotonic_clock",
      "includes_cleanup": true,
      "includes_clarification_wait": true,
      "includes": [
        "llm",
        "embedding",
        "tool",
        "retry_backoff",
        "failures",
        "timeouts",
        "cancellation"
      ],
      "breakdown": [
        "llm",
        "embedding",
        "tool",
        "retry",
        "clarification_wait"
      ],
      "aggregation": "actual_elapsed_once_per_non_overlapping_interval; no_sum_of_overlapping_subtimers",
      "missing_timestamps": "NOT_VERIFIED_not_zero"
    }
  },
  "status_policy": {
    "unsupported": "predeclared_exclude_and_report",
    "not_verified": "primary_denominator_non_success_and_report",
    "failed": "primary_denominator_non_success",
    "cancelled": "primary_denominator_non_success",
    "unknown_execution": "primary_denominator_non_success_and_report",
    "not_attempted": "exclude_and_report_separately",
    "controlled_fault": "report_separately_from_natural_external_failure",
    "controlled_parameter_case": "report_separately_from_natural_model_omission",
    "no_match_and_clarification": "exclude_from_tool_selection_denominator_but_include_task_outcome_if_supported_attempted"
  },
  "comparison_policy": {
    "common_supported_subset": "report_per_baseline_alongside_coverage; no_imputation_for_unsupported",
    "tool_pool_difference": "report_explicitly; never_attribute_missing_tool_capability_to_routing",
    "split_use": "experiment_and_prior_evaluation_are_provenance_only; independent_holdout_for_final_evaluation",
    "post_freeze_changes": "new_version_and_change_log_required; no_relabel_after_viewing_model_results"
  }
}
